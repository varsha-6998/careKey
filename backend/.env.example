# Copy to .env and fill in local values. Never commit .env.

# Application
APP_NAME=CareKey API
ENVIRONMENT=development

# PostgreSQL (SQLAlchemy URL, psycopg3 driver)
# Example: postgresql+psycopg://USER:PASSWORD@localhost:5432/carekey
DATABASE_URL=postgresql+psycopg://carekey:carekey@localhost:5432/carekey

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local prototype file storage (documents). Relative to the backend working directory.
LOCAL_STORAGE_DIR=./storage

# Optional OSRM base URL for later routing support. Leave empty to disable.
OSRM_BASE_URL=

# Firebase Admin SDK (Phase 2A). Do not put private keys or JSON contents here.
# Download a service-account key from Firebase Console → Project settings → Service accounts.
# Point this path at that file; keep the JSON out of git.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
